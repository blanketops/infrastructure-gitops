{
  "apiVersion": "policy.sigstore.dev/v1beta1",
  "kind": "ClusterImagePolicy",
  "metadata": {
    "finalizers": [
      "clusterimagepolicies.policy.sigstore.dev"
    ],
    "labels": {
      "blanketops.dev/managed": "true",
      "blanketops.dev/supply-chain-policy": "for-kaniko-app",
      "blanketops.dev/supply-chain-policy-namespace": "default"
    },
    "name": "default-for-kaniko-app-authorization"
  },
  "spec": {
    "authorities": [
      {
        "attestations": [
          {
            "name": "authorization",
            "policy": {
              "data": "predicateType: \"https://blanketops.dev/attestations/authorization/v1\"\npredicate: {\n\tscope: {principal: \"system:serviceaccount:default:supply-chain-runner\", resource: \"supplychains\", verb: \"get\", allowed: true}\n\tintent: {principal: \"system:serviceaccount:default:supply-chain-runner\", resource: \"imagebuilds\", verb: \"create\", allowed: true}\n\toutput: {principal: \"system:serviceaccount:default:supply-chain-runner\", resource: \"imagesignatures\", verb: \"create\", allowed: true}\n}\n",
              "type": "cue"
            },
            "predicateType": "https://blanketops.dev/attestations/authorization/v1"
          }
        ],
        "ctlog": {
          "trustRootRef": "default-for-kaniko-app",
          "url": "https://rekor-server.rekor-system.svc.cluster.local"
        },
        "keyless": {
          "identities": [
            {
              "issuer": "https://kubernetes.default.svc.cluster.local",
              "subject": "https://kubernetes.io/namespaces/default/serviceaccounts/supply-chain-runner"
            }
          ],
          "trustRootRef": "default-for-kaniko-app",
          "url": "https://fulcio-server.fulcio-system.svc.cluster.local"
        },
        "name": "authorization"
      }
    ],
    "images": [
      {
        "glob": "index.docker.io/nkanyezisolutions/for-kaniko-app**"
      }
    ],
    "mode": "enforce"
  }
}
